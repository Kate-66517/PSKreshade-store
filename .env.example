# Database
DATABASE_URL="postgresql://user:password@localhost:5432/reshade_store"

# Auth
AUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Signed download URLs (separate secret from AUTH_SECRET)
DOWNLOAD_SECRET="generate-a-different-long-random-string"
DOWNLOAD_URL_TTL_SECONDS=600

# Payment gateway (fill in when a real provider is wired up)
PAYMENT_MODE="test"           # "test" = MockPaymentProvider, "live" = real provider
PAYMENT_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Private object storage (S3-compatible)
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
